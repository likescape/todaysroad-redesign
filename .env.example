# Browser-visible Kakao JavaScript app key (register localhost:8000).
NEXT_PUBLIC_KAKAO_MAP_KEY=c27a21ad128ccdc8bc1b3ec50662e18b
# Only the /dev/image-route experiment uses the settings below.
# The app's recommendation button shows a fixed preview without image analysis.
# Local experiments use the existing Codex CLI login; no OpenAI API key needed.
MAP_VISION_PROVIDER=codex
# Optional executable path (defaults to codex on PATH).
# CODEX_BIN=/usr/local/bin/codex
# Optional model override; omitted uses the installed Codex default.
# CODEX_MAP_VISION_MODEL=
# Optional alternative provider: MAP_VISION_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MAP_VISION_MODEL=gpt-4.1
